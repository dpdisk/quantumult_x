<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="refresh" content="5;url=https://yfamilys.com">
    <title>域名迁移通知</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            background-color: #f5f5f7;
            color: #1d1d1f;
        }
        .container {
            text-align: center;
            padding: 40px;
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            max-width: 400px;
            width: 90%;
        }
        h1 {
            font-size: 24px;
            margin-bottom: 10px;
            color: #d93025;
        }
        p {
            font-size: 16px;
            line-height: 1.6;
            color: #484848;
        }
        .countdown {
            font-weight: bold;
            color: #007aff;
        }
        .new-domain {
            display: inline-block;
            margin-top: 20px;
            padding: 12px 24px;
            background-color: #007aff;
            color: white;
            text-decoration: none;
            border-radius: 6px;
            font-weight: 500;
            transition: background 0.2s;
        }
        .new-domain:hover {
            background-color: #0056b3;
        }
        .footer {
            margin-top: 30px;
            font-size: 12px;
            color: #86868b;
        }
    </style>
</head>
<body>

<div class="container">
    <h1>域名停用通知</h1>
    <p>当前访问的域名已停止使用。</p>
    <p>页面将在 <span id="timer" class="countdown">5</span> 秒后自动跳转至：</p>
    
    <a href="https://yfamilys.com" class="new-domain">yfamilys.com</a>

    <div class="footer">
        © 2026 yfamilys.com 保留所有权利
    </div>
</div>

<script>
    // 简单的倒计时脚本
    let timeLeft = 5;
    const timerElement = document.getElementById('timer');
    
    const interval = setInterval(() => {
        timeLeft--;
        timerElement.textContent = timeLeft;
        if (timeLeft <= 0) {
            clearInterval(interval);
        }
    }, 1000);
</script>

